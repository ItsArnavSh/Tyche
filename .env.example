# Copy to .env (docker compose reads it automatically) and adjust as needed.
#
# The Go gateway is the single owner of the market-data plane. Every setting in
# the "Market data" and "Kite Connect" sections is consumed by the gateway only;
# the Java core never fetches quotes or talks to a broker.

# ── Market data (gateway only) ─────────────────────────────────────────────
# yahoo (default, no credentials), zerodha, or fake
TYCHE_DATA_SOURCE=yahoo

# Automatic NSE index universe. The gateway downloads the official index
# constituent CSV at startup. Supported values: nifty50, niftynext50,
# nifty100, nifty200, nifty500, niftymidcap150, niftysmallcap250,
# niftylargemidcap250. Set to "off" to use the built-in fallback list.
# For offline fake data, set TYCHE_UNIVERSE=off (or keep it to simulate the
# NIFTY list with synthetic prices).
TYCHE_UNIVERSE=nifty500
# Optional full CSV URL (useful for a mirror or a controlled test).
# TYCHE_UNIVERSE_URL=
# Cap the number of symbols after filtering; 0 means no cap.
# TYCHE_UNIVERSE_LIMIT=0
# Explicit override. When non-empty this wins over TYCHE_UNIVERSE.
# TYCHE_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS,ICICIBANK.NS
# Fallback used if the NSE download fails (defaults to ten liquid NSE names).
# TYCHE_UNIVERSE_FALLBACK=

# ── Zerodha Kite Connect (gateway only) ────────────────────────────────────
# 1. Create an app at https://developers.kite.trade
# 2. docker compose run --rm gateway kite-login-url
# 3. Open the URL, log in, copy the request_token from the redirect URL
# 4. docker compose run --rm gateway kite-session <request_token>
# 5. Put the printed access token below (it expires daily).
TYCHE_KITE_API_KEY=
TYCHE_KITE_API_SECRET=
TYCHE_KITE_ACCESS_TOKEN=
TYCHE_KITE_DEFAULT_EXCHANGE=NSE
# TYCHE_KITE_BASE_URL=https://api.kite.trade

# ── Feed / engine ──────────────────────────────────────────────────────────
# TYCHE_YAHOO_BASE_URL=https://query1.finance.yahoo.com
# TYCHE_YAHOO_SUFFIX=.NS
# TYCHE_HTTP_RETRIES=3
# TYCHE_BOOT_CANDLES=300
# Bounded concurrency for history downloads during boot (default 4).
# TYCHE_BOOT_WORKERS=4
# Core engine: worker threads default to available CPUs.
# TYCHE_WORKER_THREADS=20
# Grace window for boot jobs queued behind a large universe (default 5m).
# TYCHE_BOOT_GRACE_MS=300000
# TYCHE_CACHE_MAX_CANDLES=1500
# TYCHE_ROLL_INTERVAL_MS=5000
# Failed-series re-boot retry policy. Permanent 404/400 history responses
# are blacklisted immediately; transient failures back off exponentially.
# TYCHE_REBOOT_BACKOFF_MS=10000
# TYCHE_REBOOT_MAX_BACKOFF_MS=120000
# 0 keeps retrying transient failures indefinitely.
# TYCHE_REBOOT_MAX_ATTEMPTS=0
# TYCHE_DECISION_INTERVAL_MS=5000
# TYCHE_MONITOR_INTERVAL_MS=5000
# TYCHE_HTTP_TIMEOUT_MS=15000
# TYCHE_SIGNAL_COOLDOWN_MS=60000
# Compose always listens on :8080 inside the gateway container; use
# TYCHE_STATUS_PORT for the host mapping.
# TYCHE_STATUS_ADDR=:8080

# ── Status / dashboard ─────────────────────────────────────────────────────
# Host port used by docker compose to expose the gateway status API.
TYCHE_STATUS_PORT=8080

# ── Paper trading / risk (gateway only) ────────────────────────────────────
TYCHE_INITIAL_CASH=100000
TYCHE_PAPER_FEE_BPS=0
TYCHE_MIN_CONFIDENCE=0.70
# Target this many concurrent equal-weight positions.
TYCHE_MAX_POSITIONS=10
# Upper bound on a single entry, as a fraction of portfolio equity.
TYCHE_MAX_POSITION_FRACTION=0.15
# Cash held back from position sizing for fees and rounding.
TYCHE_CASH_RESERVE_PCT=0.02
TYCHE_STOP_LOSS_PCT=0.05
TYCHE_TAKE_PROFIT_PCT=0.10
# Hard maximum holding time.  Signal-loss exits normally fire much sooner.
TYCHE_HOLD_MS=14400000
# Exit after this long with no live signal for the ticker.
TYCHE_SIGNAL_LOSS_GRACE_MS=300000
TYCHE_REBUY_COOLDOWN_MS=300000

# ── Infrastructure (compose sets these to service names automatically) ─────
# TYCHE_CORE_ADDR=localhost:50051
# TYCHE_REDIS_ADDR=localhost:6379
# TYCHE_REDIS_HOST=localhost
# TYCHE_REDIS_PORT=6379
# TYCHE_SIGNAL_QUEUE=signal
# REDIS_URL=redis://localhost:6379
